    "@size-limit/preset-small-lib": "^11.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@vauban-org/assurance-grade": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "fast-check": "^4.7.0",
    "size-limit": "^11.0.0",
    "tinybench": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@vauban-org/proof-core": "^0.1.0 || ^0.2.0 || ^0.3.0",
    "prom-client": "^15.0.0",
    "starknet": "^6.24.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": false
    },
    "@vauban-org/proof-core": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "starknet": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
